<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="820.0" spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dbeditor.controller.view.dialogs.AssociationEditorController">
  <children>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
      <children>
        <Label fx:id="lName" text="Nom de l'association (verbe à l'infinitif)"/>
        <TextField fx:id="tfAssociationName" maxWidth="1.7976931348623157E308" promptText="ex : posséder, commander, appartenir…" HBox.hgrow="ALWAYS"/>
      </children>
    </HBox>
    <Separator prefWidth="200.0"/>
    <HBox spacing="10.0">
      <children>
        <VBox alignment="CENTER" spacing="10.0">
          <children>
            <Label fx:id="lEntity" text="Entités participantes (2 - 4)"/>
            <VBox fx:id="entitiesBox"/>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <children>
                <Button fx:id="btnAddEntity" text="Ajouter entité"/>
                <Button fx:id="btnDeleteEntity" text="Retirer dernière"/>
              </children>
            </HBox>
          </children>
        </VBox>
        <Separator orientation="VERTICAL" HBox.hgrow="ALWAYS"/>
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
          <children>
            <TableView fx:id="tableColumns" editable="true">
              <placeholder>
                <Label text="Aucun attribut. Cliquez sur « Ajouter attribut »."/>
              </placeholder>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <children>
                <Button fx:id="btnAddAttr" text="Ajouter attribut"/>
                <Button fx:id="btnDeleteAttr" text="Supprimer attribut"/>
              </children>
            </HBox>
          </children>
        </VBox>
      </children>
    </HBox>
    <Separator prefWidth="200.0"/>
    <HBox alignment="CENTER_LEFT" spacing="8">
      <children>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancel" text="Annuler"/>
        <Button fx:id="btnConfirm" defaultButton="true" text="Confirmer"/>
      </children>
    </HBox>
  </children>
</VBox>
