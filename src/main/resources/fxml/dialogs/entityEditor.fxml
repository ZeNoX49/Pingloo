<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="450.0" minWidth="700.0" prefHeight="600.0" prefWidth="900.0" spacing="15" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dbeditor.controller.view.dialogs.EntityEditorController">
  <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
          <Label fx:id="lName" text="Nom de la table" />
          <TextField fx:id="tfTableName" promptText="Entrez le nom de la table" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <Separator prefWidth="200.0" />
    <TableView fx:id="tableColumns" editable="true" VBox.vgrow="ALWAYS">
      <placeholder>
        <Label text="Aucune colonne. Cliquez sur « Ajouter colonne »." />
      </placeholder>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="8">
      <children>
        <Button fx:id="btnAdd" text="＋ Ajouter colonne" />
        <Button fx:id="btnDelete" text="－ Supprimer colonne" />
      </children>
    </HBox>
      <Separator prefWidth="200.0" />
      <HBox alignment="CENTER_LEFT" spacing="8">
         <children>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" text="Annuler" />
        <Button fx:id="btnConfirm" defaultButton="true" text="Confirmer" />
         </children>
      </HBox>
  </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
